<apex:component id="ApplicantWelcomeEmail" access="global" controller="ApplicantWelcomeEmailController">

    <apex:attribute name="contactIdPassed"
        type="Id"
        assignTo="{!contactIdPassedCtrl}"
        description="Contact Id of the new applicant"/>

    
    
     <div style="max-width:650px; margin:0 auto;">

        <!-- Logo -->
        <img src="https://platform-energy-10.file.force.com/sfc/dist/version/download/?oid=00DdN00000UKZDF&ids=068OS00000Hhqum&d=%2Fa%2FOS000004q0uW%2FOARCVKVy1qerXqAty87qIdoIazXO10A_fX8xRjfq7IY&asPdf=false"
             alt="SPJIMR Logo"
             style="width:20%; height:auto; display:block; margin:0 auto 30px auto;" />

        <!-- Greeting -->
        <p style="font-family:Arial, sans-serif; font-size:16px;">
            Hi {!firstName},
        </p>

        <!-- Body -->
        <p style="font-family:Arial, sans-serif; font-size:15px; line-height:1.6;">
            Your account has been created successfully. Please reset your password to get started with your application for the
            <b>{!programmeNames}</b> programme(s).
        </p>

        <!-- Username -->
        <p style="font-family:Arial, sans-serif; font-size:15px;">
            Username:
            <b style="background-color:#f4f4f4; padding:6px 10px; border-radius:4px; border:1px solid #dddddd;">
                {!username}
            </b>
        </p>

        <!-- Reset Button -->
        <div style="text-align:center; margin:35px 0;">
            <a href="{!$Network.NetworkUrlForUserEmails}"
               target="_blank"
               style="display:inline-block;
                      background-color:#fbbc04;
                      color:#000000;
                      font-size:16px;
                      font-weight:bold;
                      padding:14px 28px;
                      text-decoration:none;
                      border-radius:6px;
                      font-family:Arial, sans-serif;">
                Reset Password
            </a>
        </div>

        <!-- Footer -->
        <div style="text-align:center; background-color:#3B1151; padding:18px; margin-top:30px;">
            <p style="color:white; font-family:Arial, sans-serif; margin:4px;">
                Warm regards,
            </p>
            <p style="color:white; font-family:Arial, sans-serif; margin:4px;">
                Admissions Team
            </p>
            <p style="color:white; font-family:Arial, sans-serif; margin:4px;">
                <b>SPJIMR</b>
            </p>
        </div>

    </div>

</apex:component>