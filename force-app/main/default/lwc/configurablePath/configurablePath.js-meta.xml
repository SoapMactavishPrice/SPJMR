<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Configurable Path</masterLabel>
    <description>Metadata-driven path bar with program-scoped dependency modal.</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <property
                name="configDeveloperName"
                type="String"
                default="B2C_Lead_Path"
                label="Path config (CMDT Developer Name)"
                description="DeveloperName of the Path_Wizard_Config__mdt row."
            />
            <objects>
                <object>Lead</object>
                <object>Opportunity</object>
            </objects>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>