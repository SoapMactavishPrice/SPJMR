    <tr><td style="border:1px solid #444; padding:6px;">Initial Rent Deposit</td><td style="border:1px solid #444; padding:6px;">EUR 650 (approx.)</td></tr>
    <tr><td style="border:1px solid #444; padding:6px;">Medical Insurance</td><td style="border:1px solid #444; padding:6px;">INR 50,000</td></tr>
