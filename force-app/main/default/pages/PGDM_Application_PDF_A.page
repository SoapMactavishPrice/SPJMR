    <td style="border:1px solid #000;padding:5px;color:#531F75;">Need to Map</td> -->
    <td style="border:1px solid #000;padding:5px;font-weight:bold;color:#531F75;">Study in India (SII) Registration Number</td>
    <td style="border:1px solid #000;padding:5px;color:#531F75;">{!PDInfo.StudyInIndiaRegNo__c}</td>
</tr>
