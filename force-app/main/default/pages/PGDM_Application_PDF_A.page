        </td>
    </tr>
    <apex:outputPanel layout="none" rendered="{!PDInfo.HavePassport__c == 'No'}">
        <tr>
            <td style="border:1px solid #000;padding:5px;font-weight:bold;color:#531F75;">Do You Have Aadhaar Card ?</td>
            <td style="border:1px solid #000;padding:5px;color:#531F75;">{!PDInfo.HaveAadhaar__c}</td>
            <td style="border:1px solid #000;padding:5px;font-weight:bold;color:#531F75;">Aadhaar Card Number</td>
            <td style="border:1px solid #000;padding:5px;color:#531F75;">{!PDInfo.AadhaarCardNumber__c}</td>
        </tr>
    </apex:outputPanel> 
    <tr>
    <td style="border:1px solid #000;padding:5px;font-weight:bold;color:#531F75;">Do You Have a Passport ?</td>
    <td style="border:1px solid #000;padding:5px;color:#531F75;">{!PDInfo.HavePassport__c}</td>
