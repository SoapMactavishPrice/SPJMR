<apex:page controller="PGDM_Application_PDF_A" renderAs="pdf" showHeader="false" applyBodyTag="false" applyHtmlTag="false" sidebar="false" cache="false" contentType="application/pdf">
    <html>
        <head>
            <style type="text/css">
                
                @page {
                size: A4;
                margin: 15mm 10mm 15mm 10mm;
                
                @bottom-right {
                content: "Page " counter(page) " / " counter(pages);
                font-family: Arial;
                font-size: 10px;
                color: #531F75;
                }
                }
                
                body{
                font-family: Arial, sans-serif;
                font-size:12px;
                }
                
                .section {
                page-break-inside: avoid;
                page-break-before: auto;
                page-break-after: auto;
                }
                
                table {
                width:100%;
                border-collapse:collapse;
                page-break-inside:avoid;
                }
                
                tr {
                page-break-inside:avoid;
                }
                
            </style>
        </head>    
<!-- ===== HEADER SECTION ===== -->
<table style="width:100%; border-collapse:collapse; font-family:Arial, sans-serif; font-size:13px">
<tr>
<td style="width:25%; text-align:left; border:none; vertical-align:middle; border: 1px solid;">
<!-- Replace with your org’s logo -->
  <apex:image alt="Sarex" url="{!$Resource.SPJMIR_logo}" height="50px" style="text-align:Center;" /><br/>
</td>
<td style="width:50%; text-align:center; font-weight:bold; font-size:16px; vertical-align:middle;    border: 1px solid;color:#531F75;font-weight:bold;">
           <!-- PGDM &amp; PGDM (BM) 2025-27<br/> -->
            PGDM &amp; PGDM (BM) 2025-27<br/>
<span style="font-size:13px;">APPLICATION NO: {!quo.Name}</span>
</td>
<td style="width:25%; text-align:right; vertical-align:middle;border: 1px solid;">
  <div style="width:90px; height:100px; overflow:hidden;  display:block; margin:auto;border:1px solid #000;">
   <img src="{!passportPhotoUrl}" style="width:90px; height:120px; object-fit:cover; "/>
  </div>
</td>
</tr>
</table>
<!-- ================= PROGRAMME DETAILS ================= -->
<table style="width:100%; border-collapse:collapse; font-family:Arial; font-size:10pt;margin-top:16px;">
    <!-- Header -->
    <tr>
        <td colspan="4" style="background:#f39c12;color:white;font-weight:bold;padding:6px;border:1px solid black;">
            Programme Details (Choose the programmes you wish to apply to for the 2025-27 intake):
        </td>
    </tr>
    <!-- Row 1 -->
    <tr>
    <td style="width:25%; border:1px solid black; padding:5px; font-weight:bold; color:#531F75;">
        1st Programme Applying for
    </td>

    <td style="width:25%; border:1px solid black; padding:5px;color:#531F75;">

        <!--
            FIRST VALUE SELECTED
            Show only the first programme.
            This also applies when BOTH values are selected.
        -->
        <apex:outputText value="Post Graduate Diploma in Management"
            rendered="{!
                OR(
                    ProgramDetails.ProgrammesInterestedIn__c = 'Post Graduate Diploma in Management',
                    CONTAINS(
                        ProgramDetails.ProgrammesInterestedIn__c,
                        'Post Graduate Diploma in Management;'
                    )
                )
            }"/>

        <!--
            ONLY SECOND VALUE SELECTED
            Show second programme as the 1st programme.
            The NOT condition prevents this from displaying when BOTH
            values are selected.
        -->
        <apex:outputText value="Post Graduate Diploma in Management (Business Management)"
            rendered="{!
                AND(
                    NOT(
                        OR(
                            ProgramDetails.ProgrammesInterestedIn__c = 'Post Graduate Diploma in Management',
                            CONTAINS(
                                ProgramDetails.ProgrammesInterestedIn__c,
                                'Post Graduate Diploma in Management;'
                            )
                        )
                    ),
                    OR(
                        ProgramDetails.ProgrammesInterestedIn__c = 'Post Graduate Diploma in Management (Business Management)',
                        CONTAINS(
                            ProgramDetails.ProgrammesInterestedIn__c,
                            ';Post Graduate Diploma in Management (Business Management)'
                        )
                    )
                )
            }"/>

    </td>

    <td style="width:25%; border:1px solid black; padding:5px; font-weight:bold; color:#531F75;">
        2nd Programme Applying for
    </td>

    <td style="width:25%; border:1px solid black; padding:5px;color:#531F75;">

        <!--
            Show second programme ONLY when BOTH values are selected.
        -->
        <apex:outputText value="Post Graduate Diploma in Management (Business Management)"
            rendered="{!
                AND(
                    OR(
                        ProgramDetails.ProgrammesInterestedIn__c = 'Post Graduate Diploma in Management',
                        CONTAINS(
                            ProgramDetails.ProgrammesInterestedIn__c,
                            'Post Graduate Diploma in Management;'
                        )
                    ),
                    OR(
                        ProgramDetails.ProgrammesInterestedIn__c = 'Post Graduate Diploma in Management (Business Management)',
                        CONTAINS(
                            ProgramDetails.ProgrammesInterestedIn__c,
                            ';Post Graduate Diploma in Management (Business Management)'
                        )
                    )
                )
                      }"/>
        
        </td>
    </tr>
    <!-- Row 2 -->
    <tr>
        <td style="border:1px solid black; padding:5px; font-weight:bold; color:#531F75;">
            Please Select Your Preference 1
        </td>
        <td style="border:1px solid black; padding:5px;color:#531F75;">
            {!ProgramDetails.PrimaryProgramPreference__c}
        </td>
        <td style="border:1px solid black; padding:5px; font-weight:bold; color:#531F75;">
            Please Select Your Preference 2
        </td>
        <td style="border:1px solid black; padding:5px;color:#531F75;">
            {!ProgramDetails.SecondaryProgramPreference__c}
        </td>
    </tr>
    <!-- Row 3 -->
    <tr>
        <td style="border:1px solid black; padding:5px; font-weight:bold; color:#531F75;">
            Specialization 1 For PGDM
        </td>
        <td style="border:1px solid black; padding:5px;color:#531F75;">
            {!ProgramDetails.PrimarySpecialisationPreference__r.Specialisation_Name__r.Name}
        </td>
        <td style="border:1px solid black; padding:5px; font-weight:bold; color:#531F75;">
            Specialization 2 For PGDM
        </td>
        <td style="border:1px solid black; padding:5px;color:#531F75;">
            {!ProgramDetails.SecondarySpecialisationPreference__r.Specialisation_Name__r.Name}
        </td>
    </tr>
    <!-- Row 4 -->
    <tr>
        <td style="border:1px solid black;padding:5px;font-weight:bold;color:#531F75;vertical-align:middle;">
            Reasons I Have (Specialization 1)
        </td>
        <td style="border:1px solid black;padding:5px;height:70px;vertical-align:top;color:#531F75;">
            {!ProgramDetails.Reasons_I_have_Specialization_1__c}
        </td>
        <td style="border:1px solid black;padding:5px;font-weight:bold;color:#531F75;vertical-align:middle;">
            Mention Your Interest 1
        </td>
        <td style="border:1px solid black;padding:5px;height:70px;vertical-align:top;color:#531F75;">
            {!ProgramDetails.OtherSpecialisation1InterestReason__c}
        </td>
    </tr>
    <!-- Row 5 -->
    <tr>
        <td style="border:1px solid black;padding:5px;font-weight:bold;color:#531F75;">
            Reasons I Have (Specialization 2)
        </td>

        <td style="border:1px solid black; padding:5px;color:#531F75;">
            {!ProgramDetails.Reasons_I_have_Specialization_2__c}
        </td>
        <td style="border:1px solid black;padding:5px;font-weight:bold;color:#531F75;">
            Mention Your Interest 2
        </td>
        <td style="border:1px solid black; padding:5px;color:#531F75;">
            {!ProgramDetails.OtherSpecialisation2InterestReason__c}
        </td>
    </tr>
    <!-- Row 6 -->
    <tr>
        <td style="border:1px solid black; padding:5px; font-weight:bold; color:#531F75;">
            Area of Interest
        </td>
        <td style="border:1px solid black; padding:5px;color:#531F75;">
            {!ProgramDetails.AreaOfInterest__c}
        </td>
        <td style="border:1px solid black; padding:5px; font-weight:bold; color:#531F75;">
            Reasons for Area of Interest
        </td>
        <td style="border:1px solid black; padding:5px;color:#531F75;">
            {!ProgramDetails.ReasonsForAreaOfInterest__c}
        </td>
    </tr>
</table>
<!-- ================= PROGRAMME DETAILS ================= -->
<!-- ================= PERSONAL INFORMATION ================= -->
