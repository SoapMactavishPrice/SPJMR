    </td>
    <td colspan="2" style="width:50%;border:1px solid #000;padding:5px;color:#531F75;">
        {!PDInfo.StudyInIndiaRegNo__c}
    </td>
</tr> -->   
<tr>
    <td colspan="4" style="background:#f39c12;color:#fff;font-weight:bold;padding:6px;border:1px solid #000;">Contact Details:</td>
</tr>
<tr>
    <td style="border:1px solid #000;padding:5px;font-weight:bold;color:#531F75;">Mobile Number</td>
