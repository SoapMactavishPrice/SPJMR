    <td style="border:1px solid #000;padding:5px;font-weight:bold;color:#531F75;">Age as on <apex:outputText value=" {!quo.Batch__r.CalculateAgeAsOf__c}"><apex:param value="dd/MM/yyyy" /></apex:outputText></td>
