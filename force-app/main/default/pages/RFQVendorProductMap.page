<apex:page controller="c_RFQVendorProductMap" lightningStylesheets="true">
    <head>
        <apex:slds />
        <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.12.0/jquery.min.js"></script>
        <script type="text/javascript">

        /* function f_msg_error(p_tittle, p_msg){
            sforce.one.showToast({
                "title": p_tittle,
                "message": p_msg,
                "type": "error"
            });
        }

        function f_msg_success(p_tittle, p_msg){
            sforce.one.showToast({
                "title": p_tittle,
                "message": p_msg,
                "type": "success"
            });
        } */

        function stopEnterKey(evt) {
            var evt = (evt) ? evt : ((event) ? event : null);
            var node = (evt.target) ? evt.target : ((evt.srcElement) ? evt.srcElement : null);
            if ((evt.keyCode == 13) && (node.type == "text")) {
                Search();
                return false;
            }else if((evt.keyCode == 13) && (node.type == "checkbox")) {
                event.preventDefault();
            }
        }

        document.onkeypress = stopEnterKey;
        
        function selectAllCheckboxes1(obj,receivedInputID){
            console.log('this is called=========');
            
            var inputCheckBox = document.getElementsByTagName("input");                  
            for(var i=0; i<inputCheckBox.length; i++){          
                if(inputCheckBox[i].id.indexOf(receivedInputID)!=-1){                                     
                    inputCheckBox[i].checked = obj.checked;
                    console.log('this is called');
                }
            }
        }

        function selectAll(obj,receivedInputID){
            if (!obj.checked) {
                let inputCheckBox = document.getElementsByTagName("input");
                for(let i=0; i<inputCheckBox.length; i++){          
                    if(inputCheckBox[i].id.indexOf(receivedInputID)!=-1){
                        inputCheckBox[i].checked = obj.checked;
                    }
                }
            }
        }

        setTimeout(function() { $('#pgmessagesid').fadeOut('fast'); }, 2000);

        </script>
    </head>

    <article class="slds-card s1FixedTop forceHighlightsStencilDesktop">
        <div id="pgmessagesid" style="width: fit-content;">
            <apex:pagemessages />
        </div>
        <!-- <div style="display: {!IF(oppty.Tax_Code__c!=null, 'block', 'none')}"> -->

        <div style="display: 'inline-block'">
            <apex:form id="frm_map_vendor_product">
                <apex:pageBlock id="pb_1">
                    
                    <div style="display: flex;flex-direction: row;">
                        
                        <div style="width: 20%;">
                            <div style="text-align: center;">
                                RFQ Vendor List <br/><br/>
                            </div>
                            <table Style="border-collapse: collapse;" id="plist" class="slds-table slds-table_bordered">
                                <tr Style="padding:5px 2px;border-collapse: collapse;" class="table_th slds-hint-parent">
                                    <th Style="width:50px;text-align:center !important;">
                                        <apex:inputCheckbox id="chk_unsel_vendor" onclick="selectAllCheckboxes1(this,'chk_rfq_vendor_list')"></apex:inputCheckbox>
                                    </th>
                                    <th class="slds-truncate slds-text-title_caps">Vendor Code</th>
                                    <th class="slds-truncate slds-text-title_caps" Style="width:30%;">Vendor Name</th>
                                </tr>
                                <apex:repeat value="{!w_VendorList}" var="p">
                                    <tr Style="padding:5px 2px;border-collapse: collapse;" class="table_tr slds-hint-parent">
                                        <td style="text-align:center !important;">
                                            <apex:inputCheckbox value="{!p.isChecked}" id="chk_rfq_vendor_list" onclick="selectAll(this,'chk_unsel_vendor')"></apex:inputCheckbox>
                                        </td>
                                        <td style="width:30%" class="slds-truncate">{!p.op.Vendor_Code__c}</td>
                                        <td style="width:50%" class="slds-truncate" role="gridcell">{!p.op.Vendor_Name__r.Name}</td>
                                    </tr>
                                </apex:repeat>
                            </table>
                        </div>
                        <div style="width: 5%;">
                            <br/><br/><br/><br/>
                            <div style="text-align: center;">
                                <apex:commandButton value=">>" action="{!f_select_vendor}" style="margin-top:10px;" styleClass="slds-button slds-button_neutral">
                                </apex:commandButton>
                            </div>
                            <div style="text-align: center;">
                                <apex:commandButton value="<<" action="{!f_unselect_vendor}" style="margin-top:10px;" styleClass="slds-button slds-button_neutral">
                                </apex:commandButton>
                            </div>
                        </div>
                        <div style="width: 20%;">
                            <div style="text-align: center;">
                                Selected Vendor List <br/><br/>
                            </div>
                            <table Style="border-collapse: collapse;" id="plist" class="slds-table slds-table_bordered">
                                <tr Style="padding:5px 2px;border-collapse: collapse;" class="table_th slds-hint-parent">
                                    <th Style="width:50px;text-align:center !important;">
                                        <apex:inputCheckbox id="chk_select_vendor" onclick="selectAllCheckboxes1(this,'chk_sel_vendor_list')"></apex:inputCheckbox>
                                    </th>
                                    <th class="slds-truncate slds-text-title_caps">Vendor Code</th>
                                    <th class="slds-truncate slds-text-title_caps" Style="width:30%;">Vendor Name</th>
                                </tr>
                                <apex:repeat value="{!w_VendorList_Selected}" var="p">
                                    <tr Style="padding:5px 2px;border-collapse: collapse;" class="table_tr slds-hint-parent">
                                        <td style="text-align:center !important;">
                                            <apex:inputCheckbox value="{!p.isChecked}" id="chk_sel_vendor_list" onclick="selectAll(this,'chk_select_vendor')"></apex:inputCheckbox>
                                        </td>
                                        <td style="width:30%" class="slds-truncate">{!p.op.Vendor_Code__c}</td>
                                        <td style="width:50%" class="slds-truncate" role="gridcell">{!p.op.Vendor_Name__r.Name}</td>
                                    </tr>
                                </apex:repeat>
                            </table>
                        </div>
                        <div style="width: 5%;"> </div>
                        <div style="width: 45%;">
                            <div style="text-align: center;">
                                Product List <br/><br/>
                            </div>
                            <table Style="border-collapse: collapse;" id="plist" class="slds-table slds-table_bordered">
                                <tr Style="padding:5px 2px;border-collapse: collapse;" class="table_th slds-hint-parent">
                                    <th Style="width:50px;text-align:center !important;">
                                        <apex:inputCheckbox id="chk_sel_item" onclick="selectAllCheckboxes1(this,'chk_rfq_product_list')"></apex:inputCheckbox>
                                    </th>
                                    <th class="slds-truncate slds-text-title_caps">Item No</th>
                                    <th class="slds-truncate slds-text-title_caps" Style="width:30%;">Item Name</th>
                                </tr>
                                <apex:repeat value="{!w_ProductList}" var="p">
                                    <tr Style="padding:5px 2px;border-collapse: collapse;" class="table_tr slds-hint-parent">
                                        <td style="text-align:center !important;">
                                            <apex:inputCheckbox value="{!p.isChecked}" id="chk_rfq_product_list" onclick="selectAll(this,'chk_sel_item')"></apex:inputCheckbox>
                                        </td>
                                        <td style="width:25%" class="slds-truncate">{!p.op.Item_Name__r.ProductCode}</td>
                                        <td style="width:65%" class="slds-truncate" role="gridcell">{!p.op.Item_Name__r.Name}</td>
                                    </tr>
                                </apex:repeat>
                            </table>
                            
                            <apex:pageBlockButtons location="Bottom">
                                <apex:commandButton value="Next Page" action="{!nextPage}" style="Float:right;margin-top:10px;"
                                                    disabled="{!isLast}" styleClass="slds-button slds-button_neutral"> </apex:commandButton>
                                <apex:commandButton value="Previous" action="{!prePage}" style="Float:right;margin-top:10px;"
                                                    disabled="{!isFirst}" styleClass="slds-button slds-button_neutral"> </apex:commandButton>
                                <div Style="Float:right;margin-top:16px;margin-right:3px;">
                                    Page &nbsp;
                                    <apex:outPutText value="{!pageNo}"></apex:outPutText>
                                    Out of &nbsp;
                                    <apex:outPutText value="{!totalPages}"></apex:outPutText>
                                </div>
                                
                                <apex:commandButton action="{!cancel}" value="Close" style="float:right;margin-right:35px;margin-top:10px;"
                                                    styleClass="slds-button slds-button_neutral"></apex:commandButton>
                                
                                <apex:commandButton value="Save" action="{!f_AddMapProduct}" style="Float:right;margin-right:5px;margin-top:10px;" styleClass="slds-button slds-button_brand"> </apex:commandButton>
                                
                            </apex:pageBlockButtons>
                            
                        </div>
                        
                    </div>
                    
                </apex:pageBlock>
                <br/>
                <apex:pageBlock id="pb_2">
                    <div style="display: flex;flex-direction: row;">
                        <div style="width: 100%;">
                            <div style="text-align: center;">
                                RFQ Vendor Product Map List <br/><br/>
                            </div>
                            <table Style="border-collapse: collapse;" id="plist" class="slds-table slds-table_bordered">
                                <tr Style="padding:5px 2px;border-collapse: collapse;" class="table_th slds-hint-parent">
                                    <th class="slds-truncate slds-text-title_caps">Vendor Code</th>
                                    <th class="slds-truncate slds-text-title_caps" Style="width:30%;">Vendor Name</th>
                                    <th class="slds-truncate slds-text-title_caps">Item No</th>
                                    <th class="slds-truncate slds-text-title_caps">Item Name</th>
                                </tr>
                                <apex:repeat value="{!vim_list}" var="p">
                                    <tr Style="padding:5px 2px;border-collapse: collapse;" class="table_tr slds-hint-parent">
                                        <td style="width:20%" class="slds-truncate">{!p.Vendor_Name__r.Vendor_Code__c}</td>
                                        <td style="width:30%" class="slds-truncate" role="gridcell">{!p.Vendor_Name__r.Name}</td>
                                        <td style="width:20%" class="slds-truncate">{!p.Item_Name__r.ProductCode}</td>
                                        <td style="width:30%" class="slds-truncate" role="gridcell">{!p.Item_Name__r.Name}</td>
                                    </tr>
                                </apex:repeat>
                            </table>
                        </div>
                    </div>
                </apex:pageBlock>
                
                
                
            </apex:form>
            
        </div>

    </article>

    <style>
        .table_th th {
            background-color:#b12327 !important;
            border:1px solid black !important;
            /*text-align:center !important;*/
            color:white !important;
        }
        .table_tr td {
            border:1px solid black !important;
            /*text-align:center !important;*/
        }
        .table_chkbox input {
            width:20px !important;
            height:20px !important;
        }
        .slds-truncate{
            white-space: initial !important;
        }
    </style>
</apex:page>