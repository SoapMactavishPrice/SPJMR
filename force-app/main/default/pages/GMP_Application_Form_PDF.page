<apex:page controller="GMP_Application_Form_PDF" renderAs="pdf" showHeader="false" applyBodyTag="false" applyHtmlTag="false" sidebar="false" cache="false" contentType="application/pdf">
<html>
<!-- ===== HEADER SECTION ===== -->
<table style="width:100%; border-collapse:collapse; font-family:Arial, sans-serif; font-size:13px">
<tr>
    <!-- LEFT LOGO -->
    <td style="width:15%; text-align:left; vertical-align:middle;">
        <apex:image url="{!$Resource.GMP_Logo}" height="50px" style="max-width:100%; height:auto;"/>
    </td>

    <!-- CENTER TEXT -->
    <td style="width:60%; text-align:center; font-weight:bold; font-size:13px; vertical-align:middle;">
        SPJIMR MUMBAI<br/>
        <span style="font-size:13px;">Application Form for {!YEAR(TODAY())}</span><br/>
        <span style="font-size:13px;">APPLICATION NO: {!quo.Name}</span>
    </td>
    
    <!-- STUDENT PHOTO (FINAL WORKING FIX) -->
    <td style="width:15%; text-align:center; vertical-align:middle; ">
        <div style="width:90px; height:120px; overflow:hidden;  display:block; margin:auto;border:1px solid #000;">
            <img src="{!passportPhotoUrl}" 
                 style="width:90px; height:120px; object-fit:cover; "/>
        </div>
    </td>


    <!-- RIGHT LOGO -->
    <td style="width:10%; text-align:right; vertical-align:middle;">
        <apex:image url="{!$Resource.SPJMIR_logo}" height="50px" style="max-width:100%; height:auto;"/>
    </td>
</tr>
</table>
<!-- ===== HEADER SECTION END ===== -->
<!-- PROGRAM DETAILS SECTION -->
<table style="width:100%; border-collapse:collapse; font-family:Arial, sans-serif; font-size:12px;margin-top:16px;">

    <!-- HEADER -->
   <!-- <tr style="background:#f58220; color:#fff; font-weight:bold; border:1px solid #000;">-->
    <tr style="background:#9173AF; font-weight:bold; border:1px solid #000;">
        <td colspan="4" style="padding:5px; border:1px solid #000;">
            Program Details
        </td>
    </tr>

    <!-- Row 1 -->
   <!-- <tr style="color:#531F75;">-->
    <tr>
        <td style="border:1px solid #000; padding:5px;font-weight:bold;">Do you have an Entrance Exam Score?</td>
        <td style="border:1px solid #000; padding:5px;">{!quo.HasExamScores__c}</td>

        <td style="border:1px solid #000; padding:5px;font-weight:bold;">Select Exam</td>
        <td style="border:1px solid #000; padding:5px;">{!quo.CompetitiveExams__c}</td>
    </tr>

    <!-- Row 2 -->
    <tr>
        <td style="border:1px solid #000; padding:5px;font-weight:bold;">GRE Score</td>
        <td style="border:1px solid #000; padding:5px;">{!CompExamDetailGRE.GRE_Total_Score__c}</td>

        <td style="border:1px solid #000; padding:5px;font-weight:bold;">GMAT Score</td>
        <td style="border:1px solid #000; padding:5px;">{!CompExamDetailGMAT.GMAT_Total_Score__c}</td>
    </tr>

    <!-- Row 3 -->
    <tr>
        <td style="border:1px solid #000; padding:5px;font-weight:bold;">CAT Score</td>
        <td style="border:1px solid #000; padding:5px;">{!CompExamDetailCAT.CAT_Overall_Percentile__c}</td>

        <td style="border:1px solid #000; padding:5px;font-weight:bold;">XAT Score</td>
        <td style="border:1px solid #000; padding:5px;">{!CompExamDetailXAT.XAT_Total_Percentile__c}</td>
    </tr>

    <!-- Row 4 -->
    <tr>
        <td style="border:1px solid #000; padding:5px;font-weight:bold;">NMAT Score</td>
        <td style="border:1px solid #000; padding:5px;">{!CompExamDetailNMAT.Total_NMAT_Score_Obtained__c}</td>

        <td style="border:1px solid #000; padding:5px;font-weight:bold;">GMAT Focus Score</td>
        <td style="border:1px solid #000; padding:5px;">{!CompExamDetailGMATFocusEdition.GMAT_Focus_Edition_Total_Score__c}</td>
    </tr>

    <!-- Row 5 -->
    <tr>
        <td style="border:1px solid #000; padding:5px;font-weight:bold;">When do you plan to give the entrance exam?</td>
        <td style="border:1px solid #000; padding:5px;"><apex:outputText value=" {!quo.PlannedExamDate__c}"><apex:param value="dd/MM/yyyy" /></apex:outputText></td>

        <td style="border:1px solid #000; padding:5px;font-weight:bold;">Have you completed your graduation?</td>
        <td style="border:1px solid #000; padding:5px;">{!BAD.GraduationCompleted__c}</td>
    </tr>

    <!-- Row 6 -->
    <tr>
        <apex:outputPanel layout="none" rendered="{!BAD.GraduationCompleted__c == 'Yes'}">
        <td style="border:1px solid #000; padding:5px;font-weight:bold;">Graduated Year</td>
        <td style="border:1px solid #000; padding:5px;">{!AcaDetailGrad.MonthAndYearOfPassingFormula__c}</td>
        <td style="border:1px solid #000; padding:5px;"></td>
        <td style="border:1px solid #000; padding:5px;"></td>    
        </apex:outputPanel> 
        <apex:outputPanel layout="none" rendered="{!BAD.GraduationCompleted__c != 'Yes'}">
        <td style="border:1px solid #000; padding:5px;font-weight:bold;">Expected Graduation Date</td>
        <td style="border:1px solid #000; padding:5px;">{!AcaDetailGrad.MonthAndYearOfPassingFormula__c}</td>
        <td style="border:1px solid #000; padding:5px;"></td>
        <td style="border:1px solid #000; padding:5px;"></td>    
      <!--  <td style="border:1px solid #000; padding:5px;"><apex:outputText value=" {!BAD.ExpectedGraduationDate__c}"><apex:param value="dd/MM/yyyy" /></apex:outputText></td> -->
        </apex:outputPanel> 
    </tr>

    <!-- Last Row -->
    <tr>
        <td style="border:1px solid #000; padding:5px;font-weight:bold;">Please select the intake batch for which you want to apply.</td>
        <td colspan="3" style="border:1px solid #000; padding:5px;">{!quo.Batch__r.name}</td>
    </tr>

</table>
<!-- PERSONAL DETAILS -->
<table style="width:100%; border-collapse:collapse; font-family:Arial; font-size:12px;margin-top:16px;">

    <!-- Header -->
    <tr style="background:#9173AF; font-weight:bold; border:1px solid #000;">
        <td colspan="4" style="padding:5px; border:1px solid #000;">Personal Details</td>
    </tr>

    <!-- Row 1 -->
    <tr>
        <td style="border:1px solid #000; padding:5px; width:20%;font-weight:bold;">Name</td>
        <td colspan="3" style="border:1px solid #000; padding:5px;">{!PDInfo.Title__c} {!PDInfo.First_Name__c} {!PDInfo.Middle_Name__c} {!PDInfo.Last_Name__c}</td>
    </tr>

    <!-- Row 2 -->
    <tr>
        <td style="border:1px solid #000; padding:5px;font-weight:bold;">Gender</td>
        <td style="border:1px solid #000; padding:5px;">{!PDInfo.Gender__c} </td>

        <td style="border:1px solid #000; padding:5px;font-weight:bold;">Date of Birth</td>
        <td style="border:1px solid #000; padding:5px;"><apex:outputText value=" {!PDInfo.Date_of_Birth_As_Per_10th_Marksheet__c}"><apex:param value="dd/MM/yyyy" /></apex:outputText></td>
    </tr>

    <!-- Row 3 -->
    <tr>
        <td style="border:1px solid #000; padding:5px;font-weight:bold;">Age as on <apex:outputText value=" {!quo.Batch__r.CalculateAgeAsOf__c}"><apex:param value="dd/MM/yyyy" /></apex:outputText></td>
        <td colspan="3" style="border:1px solid #000; padding:5px;">{!PDInfo.Age__c}</td>
    </tr>
    
    <tr>
        <td style="border:1px solid #000; padding:5px;font-weight:bold;">Nationality</td>
        <td colspan="3" style="border:1px solid #000; padding:5px;">{!PDInfo.Nationality__c}</td>
    </tr>
    
    <tr>
        <apex:outputPanel layout="none" rendered="{!PDInfo.Nationality__c == 'Indian'}">
        <td style="border:1px solid #000; padding:5px;font-weight:bold;">Do you have a Passport?</td>
        <td style="border:1px solid #000; padding:5px;">{!PDInfo.HavePassport__c}</td>
        </apex:outputPanel>
        
        <!-- Logic for Indian -->
        <apex:outputPanel layout="none" rendered="{!PDInfo.Nationality__c == 'Indian' && PDInfo.HavePassport__c == 'Yes'}">
            <td style="border:1px solid #000; padding:5px;font-weight:bold;">Passport Number</td>
            <td style="border:1px solid #000; padding:5px;">{!PDInfo.PassportNumber__c}</td>
        </apex:outputPanel>
        
        <apex:outputPanel layout="none" rendered="{!PDInfo.Nationality__c == 'Indian' && (PDInfo.HavePassport__c == 'No' || PDInfo.HavePassport__c == null)}">
            <td style="border:1px solid #000; padding:5px;font-weight:bold;">Passport Application Number</td>
            <td style="border:1px solid #000; padding:5px;">{!PDInfo.PassportApplicationNumber__c}</td>
        </apex:outputPanel>
        
        <!-- Logic for Non-Indian -->
        <apex:outputPanel layout="none" rendered="{!PDInfo.Nationality__c != 'Indian'}">
            <td style="border:1px solid #000; padding:5px;font-weight:bold;">Passport Number</td>
            <td style="border:1px solid #000; padding:5px;">{!PDInfo.PassportNumber__c}</td>
            <td style="border:1px solid #000; padding:5px;font-weight:bold;"></td>
            <td style="border:1px solid #000; padding:5px;"></td>
        </apex:outputPanel>
    </tr>
    
    <apex:outputPanel layout="none" rendered="{!PDInfo.Nationality__c == 'Indian'}">
        <tr>
          <!--  <td style="border:1px solid #000; padding:5px;font-weight:bold;">Do you have Aadhaar Card ?</td>
            <td style="border:1px solid #000; padding:5px;">{!PDInfo.Do_you_have_Aadhaar_Card__c}</td> -->
            
            <td style="border:1px solid #000; padding:5px;font-weight:bold;">Aadhaar Card Number</td>
            <td colspan="3" style="border:1px solid #000; padding:5px;">{!PDInfo.AadhaarCardNumber__c}</td>
        </tr>
   </apex:outputPanel>

</table>
<!-- CONTACT DETAILS -->
<table style="width:100%; border-collapse:collapse; font-family:Arial; font-size:12px; margin-top:10px;">

    <!-- Header -->
    <tr style="background:#9173AF; font-weight:bold; border:1px solid #000;">
        <td colspan="4" style="padding:5px; border:1px solid #000;">Contact Details</td>
    </tr>

    <!-- Row 1 -->
    <tr>
        <td style="border:1px solid #000; padding:5px;font-weight:bold;">Email Address</td>
        <td style="border:1px solid #000; padding:5px;">{!PDInfo.Primary_E_mail__c} </td>

        <td style="border:1px solid #000; padding:5px;font-weight:bold;">Alternate Email Address</td>
        <td style="border:1px solid #000; padding:5px;">{!PDInfo.Alternate_E_mail__c} </td>
    </tr>

    <!-- Row 2 -->
    <tr>
        <td style="border:1px solid #000; padding:5px;font-weight:bold;">Mobile Number</td>
        <td style="border:1px solid #000; padding:5px;">{!PDInfo.Mobile_Number__c} </td>

        <td style="border:1px solid #000; padding:5px;font-weight:bold;">Alternate Mobile Number</td>
        <td style="border:1px solid #000; padding:5px;">{!PDInfo.Alternate_Mobile_Number__c} </td>
    </tr>

    <!-- Row 3 -->
    <tr>
        <td style="border:1px solid #000; padding:5px;font-weight:bold;">WhatsApp Mobile Number</td>
        <td style="border:1px solid #000; padding:5px;">{!PDInfo.WhatsApp_Mobile_Number__c} </td>

        <td style="border:1px solid #000; padding:5px;font-weight:bold;">LinkedIn ID</td>
        <td style="border:1px solid #000; padding:5px;">{!PDInfo.LinkedIn_Profile_URL__c} </td>
    </tr>

</table>
<!-- PARENT DETAILS -->
<table style="width:100%; border-collapse:collapse; font-family:Arial; font-size:12px; margin-top:10px;">

    <!-- Header -->
    <tr style="background:#9173AF; font-weight:bold; border:1px solid #000;">
        <td colspan="4" style="padding:5px; border:1px solid #000;">Parent/Guardian Details</td>
    </tr>

    <!-- Sub-header -->
    <tr style="background:#E9DFF0; font-weight:bold; border:1px solid #000;">
