         <td style="border:1px solid #000; padding:5px;">
            {!IF(
            PDInfo.GuardianOccupation__c = "Other",
            PDInfo.OtherGuardianOccupation__c,
            PDInfo.GuardianOccupation__c
            )}
        </td>
