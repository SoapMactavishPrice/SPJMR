<apex:page controller="RegistrationPDF" sidebar="false" showHeader="false">
    <html>
        <apex:slds />
        
        
        <body class="slds-scope">
           <apex:form >  
            <div style="width:90%;margin-top:-20px;margin-left: 70px;text-align:center;display:inline-flex;">
                <div style="min-width:500px;margin:30px auto;text-align:center;">
                        <div Style="Float:left;">To*:</div>
                        <apex:inputText value="{!emailId}" label="Enter Email Id" styleClass="slds-input" style="width:100%;Margin-top:5px;" required="true"></apex:inputText>
                        <div Style="Float:left;"> Subject*:</div>
                        <apex:inputText value="{!subject}" label="Enter Subject" styleClass="slds-input" style="width:100%;Margin-top:5px;" required="false"></apex:inputText>
                        <div Style="Float:left;">Body:</div>
                        <apex:inputTextarea value="{!body}" label="Body" styleClass="slds-input" style="width:100%;Margin-top:5px;"></apex:inputTextarea>&nbsp;
                        <apex:commandButton action="{!Cancel}" value="Cancel" styleClass="slds-button slds-button_destructive slds-button__icon_right slds-button--brand slds-m-top--medium" style="Margin-top:5px;margin-left: -1px;float:right;" immediate="true"></apex:commandButton>
                        <apex:commandButton action="{!saveTemp}" value="Save" styleClass="slds-button slds-button_brand" style="Margin-top:5px;float:right;margin-right:5px;" immediate="true"></apex:commandButton>
                        <apex:commandButton action="{!saveAndSend}" value="Save And Send" styleClass="slds-button slds-button_brand" style="Margin-top:5px;float:right;" ></apex:commandButton>
                </div>
            </div>
                <div class="slds-box" style="width: 90%;margin:auto;border: 0.5px solid black;margin-bottom:5px">  
                    <div>
                        <table style=" width:100%; border:none; border-collapse: collapse; ">
                            <tr>
                                <td><img style="width:1500px;height:60px" alt="logo" src="{!$Resource.AksharLogo}"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                    <div>
                        <table style=" width: 100%; border:none; border-collapse: collapse;;margin-bottom:15px;"> 
                            <tr>
                                <th  colspan="3" style="font-size:18px;text-align:left;">
                                    Registration Form
                                </th> 
                            </tr> 
                        </table>
                        <table style=" width: 100%; border:none; border-collapse: collapse;;margin-bottom:15px;"> 
                            
                            <tr>
                                <td style="padding:5px 5px;font-size:12px;width:35%">
                                    <b> Name of the Child :</b> {!acc.Name}
                                </td>
                                <td style="padding:5px 5px;font-size:12px;width:25%">
                                    <b> Gender : </b>  {!acc.Gender__c }
                                </td>
                                <td style="padding:5px 5px;font-size:12px;width:25%">
                                    <b> Date of Birth : </b>
                                    <apex:outputText value="{0,date,dd/MM/yyyy}">
                                        <apex:param value="{!acc.Date_Of_Birth__c }" />
                                    </apex:outputText> 
                                </td>
                                <td rowspan="3" style="padding:5px 5px;font-size:12px;width:25%">
                                    <apex:image url="/servlet/servlet.FileDownload?file={!childimage}" style="height:80px;width:70px;float:right;margin-right:25px;"/>
                                </td>
                            </tr>  
                            
                            <tr>
                                <td style="padding:5px 5px;font-size:12px;width:35%">
                                    <b> Blood Group :</b>  {!acc.Blood_Group__c }
                                </td>
                                <td style="padding:5px 5px;font-size:12px;width:25%">
                                    <b> Place of Birth : </b>  {!acc.Place_of_Birth__c }
                                </td>
                                <td style="padding:5px 5px;font-size:12px;width:25%">
                                    <b> Nationality : </b>  {!acc.Nationality__c }
                                </td>                                    
                            </tr>
                            <tr>
                                <td style="padding:5px 5px;font-size:12px;width:35%">
                                    <b> Admission In:</b>  {!acc.Admission_In__c }
                                </td>
                                <td style="padding:5px 5px;font-size:12px;width:25%">
                                </td>
                                <td style="padding:5px 5px;font-size:12px;width:25%">
                                </td>                                    
                            </tr>
                            
                        </table>
                        
                        <div style="page-break-after:always;">
                            <table style=" width: 100%; border:none; border-collapse: collapse;;margin-bottom:15px;">
                                <tr>
                                    <th  colspan="3" style="font-size:15px;text-align:left">
                                        Name &amp; Address of the previous school (if applicable)
                                    </th> 
                                </tr>
                                <tr>
                                    <td style="padding:5px 5px;font-size:12px;width:50%">
                                        <b> School Name :</b>  {!acc.Previous_School_If_Any__c }
                                    </td>
                                    <td style="padding:5px 5px;font-size:12px;width:50%">
                                        <b> Address : </b> {!acc.BillingStreet} {!acc.BillingCity} {!acc.BillingPostalCode} {!acc.BillingState} {!acc.BillingCountry}
                                    </td>
                                </tr>
                            </table>
                            <table style=" width: 100%; border:none; border-collapse: collapse;;margin-bottom:15px;">
                                
                                <tr>
                                    <th  colspan="2" style="font-size:15px;text-align:left">
                                        Home Address
                                    </th> 
                                </tr>
                                
                                <tr>
                                    <td style="padding:5px 5px;font-size:12px;width:50%">
                                        <b> Address :</b>  {!acc.ShippingStreet} {!acc.ShippingCity} {!acc.ShippingPostalCode} {!acc.ShippingState} {!acc.ShippingCountry}
                                    </td>
                                    <td style="padding:5px 5px;font-size:12px;">
                                        <b> Telephone No : </b>  {!acc.Telephone_No__c}
                                    </td>
                                </tr>
                            </table>
                            
                            <apex:outputPanel id="tab" rendered="{!(mother.size!=0)}">
                                
                                <table style=" width: 100%; border:none; border-collapse: collapse;margin-bottom:15px;"> 
                                    <tr>
                                        <th  colspan="3" style="font-size:15px;text-align:left">
                                            Mother's Details
                                        </th> 
                                    </tr> 
                                    <tr>
                                        <td style="padding:5px 5px;font-size:12px;width:35%">
                                            <b> Name :</b> {!mother[0].Parent_Name__c}
                                        </td>
                                        <td style="padding:5px 5px;font-size:12px;width:25%">
                                            <b> Qualification : </b> {!mother[0].Qualification__c }
                                        </td>
                                        <td style="padding:5px 5px;font-size:12px;width:25%">
                                            <b> Designation : </b> {!mother[0].Designation__c } 
                                        </td>
                                        <td rowspan="3" style="padding:5px 5px;font-size:12px;width:25%">
                                            <apex:image url="/servlet/servlet.FileDownload?file={!motherimage}" style="height:80px;width:70px;float:right;margin-right:25px;"/>
                                        </td>
                                    </tr>  
                                    <tr>
                                        <td style="padding:5px 5px;font-size:12px;width:35%">
                                            <b> Telephone No :</b> {!mother[0].Telephone_No_Home__c }
                                        </td>
                                        <td style="padding:5px 5px;font-size:12px;width:25%">
                                            <b> Mobile No :</b> {!mother[0].Mobile__c }
                                        </td>
                                        <td style="padding:5px 5px;font-size:12px;width:25%">
                                            <b> Email Id :</b> {!mother[0].Email_Id__c } 
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:5px 5px;font-size:12px;width:35%">
                                            <b> Office Address :</b> {!mother[0].Parent_Address_Info__c }
                                        </td>
                                        <td style="padding:5px 5px;font-size:12px;width:25%">
                                        </td>  
                                        <td style="padding:5px 5px;font-size:12px;width:25%">
                                        </td>  
                                    </tr>
                                </table>
                            </apex:outputPanel>
                            
                            <apex:outputPanel id="tab1" rendered="{!(father.size!=0)}">
                                
                                <table style=" width: 100%; border:none; border-collapse: collapse;margin-bottom:15px;"> 
                                    <tr>
                                        <th  colspan="3" style="font-size:15px;text-align:left">
                                            Father's Details
                                        </th> 
                                    </tr> 
                                    
                                    <tr>
                                        <td style="padding:5px 5px;font-size:12px;width:35%">
                                            <b> Name :</b> {!father[0].Parent_Name__c }
                                        </td>
                                        <td style="padding:5px 5px;font-size:12px;width:25%">
                                            <b> Qualification : </b> {!father[0].Qualification__c }
                                        </td>
                                        <td style="padding:5px 5px;font-size:12px;width:25%">
                                            <b> Designation : </b> {!father[0].Designation__c } 
                                        </td>
                                        <td rowspan="3" style="padding:5px 5px;font-size:12px;width:25%">
                                            <apex:image url="/servlet/servlet.FileDownload?file={!fatherimage}" style="height:80px;width:70px;float:right;margin-right:25px;"/>
                                        </td>
                                    </tr>  
                                    <tr>
                                        <td style="padding:5px 5px;font-size:12px;width:35%">
                                            <b> Telephone No :</b> {!father[0].Telephone_No_Home__c }
                                        </td>
                                        <td style="padding:5px 5px;font-size:12px;width:25%">
                                            <b> Mobile No :</b> {!father[0].Mobile__c }
                                        </td>
                                        <td style="padding:5px 5px;font-size:12px;width:25%">
                                            <b> Email Id :</b> {!father[0].Email_Id__c }
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:5px 5px;font-size:12px;width:35%">
                                            <b> Office Address :</b> {!father[0].Parent_Address_Info__c }
                                        </td>
                                        <td style="padding:5px 5px;font-size:12px;width:25%">
                                        </td> 
                                        <td style="padding:5px 5px;font-size:12px;width:25%">
                                        </td> 
                                    </tr>
                                </table>
                            </apex:outputPanel>
                            
                            <apex:outputPanel id="tab2" rendered="{!(Guardian.size!=0)}">
                                <table style=" width: 100%; border:none; border-collapse: collapse;margin-bottom:15px;"> 
                                    <tr>
                                        <th  colspan="3" style="font-size:15px;text-align:left">
                                            Guardian's Details
                                        </th> 
                                    </tr> 
                                    <tr>
                                        <td style="padding:5px 5px;font-size:12px;width:33.33%">
                                            <b> Name :</b> {!Guardian[0].Parent_Name__c}
                                        </td>
                                        <td style="padding:5px 5px;font-size:12px;width:33.33%">
                                            <b> Qualification : </b> {!Guardian[0].Qualification__c }
                                        </td>
                                        <td style="padding:5px 5px;font-size:12px;width:33.33%">
                                            <b> Designation : </b> {!Guardian[0].Designation__c } 
                                        </td>
                                    </tr>  
                                    <tr>
                                        <td style="padding:5px 5px;font-size:12px;width:33.33%">
                                            <b> Telephone No :</b> {!Guardian[0].Telephone_No_Home__c }
                                        </td>
                                        <td style="padding:5px 5px;font-size:12px;">
                                            <b> Mobile No :</b> {!Guardian[0].Mobile__c }
                                        </td>
                                        <td style="padding:5px 5px;font-size:12px;">
                                            <b> Email Id :</b> {!Guardian[0].Email_Id__c } 
                                        </td>
                                    </tr>
                                </table>
                                <table style=" width: 100%; border:none; border-collapse: collapse;margin-top:-15px;margin-bottom:15px;"> 
                                    <tr>
                                        <td style="padding:5px 5px;font-size:12px;width:100%">
                                            <b> Office Address :</b> {!Guardian[0].Parent_Address_Info__c }
                                        </td>
                                    </tr>
                                </table>
                            </apex:outputPanel>
                            
                            <apex:outputPanel id="tab124" rendered="{!(sibling.size!=0)}">
                                <table style=" width: 100%; border:none; border-collapse: collapse;margin-top:15px; ">  
                                    <tr>
                                        <th  colspan="3" style="font-size:15px;text-align:left">
                                            Sibling Details
                                        </th> 
                                    </tr>
                                    <tr> 
                                        <th style="padding:5px 5px;font-size:12px;width:16.66%;">Name</th>
                                        <th style="padding:5px 5px;font-size:12px;width:16.66%;">Gender</th>
                                        <th style="padding:5px 5px;font-size:12px;width:16.66%;">Date of Birth</th> 
                                        <th style="padding:5px 5px;font-size:12px;width:16.66%;">Present School</th>
                                    </tr>
                                    
                                    <apex:repeat value="{!sibling}" var="sib"> 
                                        <tr>
                                            <td style="padding:5px 5px;font-size:12px;width:16.66%;"><apex:outputText value="{!sib.Name}"></apex:outputText></td>
                                            <td style="padding:5px 5px;font-size:12px;width:16.66%;"><apex:outputField value="{!sib.Gender__c}"></apex:outputField></td>
                                            <td style="padding:5px 5px;font-size:12px;width:16.66%;">
                                                <apex:outputText value="{0,date,dd/MM/yyyy}">
                                                    <apex:param value="{!sib.Date_of_Birth__c }" />
                                                </apex:outputText> </td>
                                            <td style="padding:5px 5px;font-size:12px;width:16.66%;"><apex:outputField value="{!sib.Other_School_Name__c}"></apex:outputField></td>
                                        </tr>   
                                    </apex:repeat> 
                                </table>
                            </apex:outputPanel>
                            <table style=" width: 100%; border:none; border-collapse: collapse;margin-bottom:15px;margin-top:15px;"> 
                                <tr>
                                    <td style="padding:5px 5px;font-size:12px;width:100%">
                                        <b> Address for correspondence :</b> {!acc.Address_for_correspondence__c}
                                    </td>
                                </tr>
                            </table>
                            <table style=" width: 100%; border:none; border-collapse: collapse;"> 
                                <tr>
                                    <td style="padding:5px 5px;font-size:12px;width:100%">
                                        <b>Emergency Contact Details: </b> (If we cannot be reached in case of emergency or cannot collect our child on a normal day, the following person is authorized to act on our behalf)
                                    </td>
                                </tr>
                            </table>
                            
                            <table style=" width: 100%; border:none; border-collapse: collapse;"> 
                                
                                <tr>
                                    <td style="padding:5px 5px;font-size:12px;width:33.33%">
                                        <b> Name :</b>{!acc.Emergency_Contact_Name__c}
                                    </td>
                                    <td style="padding:5px 5px;font-size:12px;width:33.33%">
                                        <b> Relationship with the child : </b> {!acc.Emergency_Contact_Relationship__c}
                                    </td>
                                    <td style="padding:5px 5px;font-size:12px;width:33.33%">
                                        <b> Contact No : </b> {!acc.Emergency_Contact_No_Other_than_Parents__c}
                                    </td>
                                </tr>  
                            </table>
                        </div>
                        <!---------------2nd Page Starts Here----------->
                        
                        <table style=" width: 100%; border:none; border-collapse: collapse;"> 
                            <tr>
                                <td style="padding:5px 5px;font-size:13px;width:100%">
                                    <b>Child's History: Please tell us about your child, so that we may better understand him/her</b>
                                </td>
                            </tr>
                        </table>
                        
                        <table style=" width: 100%; border:none; border-collapse: collapse;margin-top:10px;"> 
                            
                            <tr>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:70%">
                                    
                                </td>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:10%">
                                    
                                </td>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:20%;text-align:center">
                                    <b>Remarks</b> 
                                </td>
                            </tr>
                            
                            <tr>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:70%">
                                    What Language Does your child speak at home?
                                </td>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:10%">
                                    {!acc.What_Language_your_child_speaks_at_home__c } 
                                </td>
                                <td style="padding:10px 10px;border:0.5px solid black;font-size:12px;width:20%">
                                    
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:90%">
                                    Does your child speak/understand English? 
                                </td>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:10%">
                                    {!acc.Does_child_speakunderstand_English__c }
                                </td>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:20%">
                                    
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:90%">
                                    Is your child speaking his/her language at an appropriate level for his/her age?
                                </td>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:10%">
                                    {!acc.Speaking_language_at_appropriate_level__c }
                                </td>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:20%">
                                    
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:90%">
                                    Do you have any difficulty in understanding your child's speech? 
                                </td>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:10%">
                                    {!acc.Difficulty_in_understanding_child_speech__c }
                                </td>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:20%">
                                    
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:90%">
                                    Is your child toilet trained? 
                                </td>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:10%">
                                    {!acc.Is_your_child_toilet_trained__c }
                                </td>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:20%">
                                    
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:90%">
                                    Did your child reach the developemental milestones at an appropriate time? E.g Sitting up, Standing, walking, crawling, talking
                                    
                                </td>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:10%">
                                    {!acc.Developmental_milestones_at_correct_time__c }
                                </td>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:20%">
                                    {!acc.Comment_7__c}
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:90%">
                                    Has your child undergone any major illness? (if yes, please provide details)
                                </td>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:10%">
                                    {!acc.Has_the_child_suffered_any_major_illness__c }   
                                </td>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:20%">
                                    {!acc.Comment_1__c}
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:90%">
                                    Has your child undergone any major surgery? (if yes, please provide details)
                                </td>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:10%">
                                    {!acc.Has_child_undergone_any_major_surgery__c }
                                </td>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:20%">
                                    {!acc.Comment_2__c}
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:90%">
                                    Does your child have any allergies? (if yes, please provide details)
                                </td>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:10%">
                                    {!acc.Does_your_child_have_any_allergies__c }
                                </td>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:20%">
                                    {!acc.Comment_3__c}
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:90%">
                                    Does your child have any specific fears? (if yes, please provide details)
                                </td>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:10%">
                                    {!acc.Child_have_any_specific_fears__c }
                                </td>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:20%">
                                    {!acc.Comment_4__c }
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:90%">
                                    Does your child have any specific learning, physical and behavioural difficulties? (if yes, please provide details)
                                    
                                </td>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:10%">
                                    {!acc.Does_child_have_any_specific_difficulty__c }
                                </td>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:20%">
                                    {!acc.Comment_5__c }
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:90%">
                                    Do you have any general comments about your child which you wish to place on record? E.g Special interest or talents
                                </td>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:10%">
                                    {!acc.General_comments_about_your_child__c }
                                </td>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:20%">
                                    {!acc.Comment_8__c }
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:90%">
                                    Do you consent making your name and home phone number available to other parents in your childs class?
                                </td>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:10%">
                                    {!acc.Make_your_contact_details_available__c }
                                </td>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:20%">
                                    
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:5px 5px;border:0.5px solid black;font-size:12px;width:90%">
