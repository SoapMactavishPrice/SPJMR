<apex:page controller="ViewOutstandingOnFeeplan" sidebar="false" showHeader="false" standardStylesheets="false">
    <html ng-app="myApp">
        <head>
            <apex:slds />
            <script src="//ajax.googleapis.com/ajax/libs/angularjs/1.5.5/angular.js"></script>
            <script src="//ajax.googleapis.com/ajax/libs/angularjs/1.5.5/angular-animate.js"></script>
            <script src="//angular-ui.github.io/bootstrap/ui-bootstrap-tpls-2.0.0.js"></script>
            <link href="//netdna.bootstrapcdn.com/bootstrap/3.3.6/css/bootstrap.min.css" rel="stylesheet" />
                </head>
                <style>
                    .panel-title{
                        font-size:18px !important;
                        
                    }
                    .ng-binding{
                        font-size: 15px;
                    }
                    .slds-scope .slds-truncate {
                        max-width: 100%;
                        overflow: hidden;
                        text-overflow: ellipsis;
                        white-space: nowrap;
                        font-size: 11.5px;
                    }
                    .slds-scope input[type=submit] {
                        -webkit-appearance: button;
                        cursor: pointer;
                        font-size: 16px;
                        padding: 6px;
                    }
                </style>
            <body ng-controller="myCtrl"><br/><br/>
                
                <div class="slds-box" style="width: 98%;margin:auto"> 
                    
                    <p class="slds-text-title_caps" style="text-align:center;font-size:20px">Outstanding Information</p> 
                    
                    <uib-accordion close-others="oneAtATime">
                        
                        <div uib-accordion-group="uib-accordion-group" class="panel-default" ng-repeat="group in preparedFeePlanListString" is-open="group.open">
                        <uib-accordion-heading style="font-size:18px">
                       {{group.Program_Name__r.Name}}  >>  {{group.Batch_Name__r.Name}}  >>  {{group.Fee_Plan_Name__r.Name}}                                  
            <i class="pull-right glyphicon" ng-class="{'glyphicon-chevron-down': group.open, 'glyphicon-chevron-right': !group.open}"></i>
                        </uib-accordion-heading>
                            
                        <div>
                <table class="slds-table slds-table_bordered slds-scrollable--x slds-table_col-bordered slds-table_resizable-cols slds-border_right slds-border_left">
                  <thead ng-if="group.Child.length > 0">
                    <tr class="slds-line-height_reset">
                      <th class="" scope="col" style="text-align:center;">
                        <div class="slds-truncate" title="Opportunity Name">Instalment Name</div>
                      </th>
                      <th class="" scope="col" style="text-align:center;">
                        <div class="slds-truncate" title="Account Name">Instalment Fees</div>
                      </th>
                      <th class="" scope="col" style="text-align:center;">
                        <div class="slds-truncate" title="Close Date">Amt Received</div>
                      </th>
                      <th class="" scope="col" style="text-align:center;">
                        <div class="slds-truncate" title="Stage">Remaining Amt</div>
                      </th>
                      <th class="" scope="col" style="text-align:center;">
                        <div class="slds-truncate" title="Confidence">Amt Received Date</div>
                      </th>
                      <th class="" scope="col" style="text-align:center;">
                        <div class="slds-truncate" title="Amount">Payment Source</div>
                      </th>
                      <th class="" scope="col" style="text-align:center;">
                        <div class="slds-truncate" title="Contact">Cheque No</div>
                      </th>
                      <th class="" scope="col" style="text-align:center;">
                        <div class="slds-truncate" title="Contact">Cheque Issue Date</div>
                      </th>
                      <th class="" scope="col" style="text-align:center;">
                        <div class="slds-truncate" title="Contact">Cheque Deposit Date</div>
                      </th>
                      <th class="" scope="col" style="text-align:center;">
                        <div class="slds-truncate" title="Contact">Transaction Ref No</div>
                      </th>
                      <th class="" scope="col" style="text-align:center;">
                        <div class="slds-truncate" title="Contact">Date of Transaction</div>
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr class="slds-hint-parent" ng-repeat="g in group.Child">
                      <td data-label="Account Name"  style="text-align:center;">
                        <div class="slds-truncate" title="Cloudhub">{{g.Instalment_Name__r.Name}}</div>
                      </td>
                      <td data-label="Account Name"  style="text-align:center;">
                        <div class="slds-truncate" title="Cloudhub">{{g.Instalment_Fees__c | number : 2 }}</div>
                      </td>
                      <td data-label="Close Date"  style="text-align:center;">
                        <div class="slds-truncate" title="4/14/2015">{{g.Amount_Received__c | number : 2 }}</div>
                      </td>
                      <td data-label="Prospecting"  style="text-align:center;">
                        <div class="slds-truncate" title="Prospecting">{{g.Remaining_Amount__c | number : 2 }} </div>
                      </td>
                      <td data-label="Confidence"  style="text-align:center;">
                        <div class="slds-truncate" title="20%">{{g.Amount_Received_Date__c}}</div>
                      </td>
                      <td data-label="Amount"  style="text-align:center;">
                        <div class="slds-truncate" title="$25k">{{g.Payment_Source__c}}</div>
                      </td>
                      <td data-label="Amount"  style="text-align:center;">
                        <div class="slds-truncate" title="$25k">{{g.Cheque_Number__c}}</div>
                      </td>
                      <td data-label="Amount"  style="text-align:center;">
                        <div class="slds-truncate" title="$25k">{{g.Cheque_Issue_Date__c}}</div>
                      </td>
                      <td data-label="Amount"  style="text-align:center;">
                        <div class="slds-truncate" title="$25k">{{g.Cheque_Deposit_Date__c}}</div>
                      </td>
                      <td data-label="Amount"  style="text-align:center;">
                        <div class="slds-truncate" title="$25k">{{g.Transaction_Reference_Number__c}}</div>
                      </td>
                      <td data-label="Amount"  style="text-align:center;">
                        <div class="slds-truncate" title="$25k">{{g.Date_of_Transaction__c}}</div>
                      </td>
                    </tr>
                  </tbody>
                </table>
            </div>
        </div>
    </uib-accordion>
    <apex:form >
        <div align="center" draggable="false">
            <apex:commandButton action="{!Cancel}" styleClass="slds-button slds-button_brand float-right" value="Cancel"></apex:commandButton>  
            </div>
            </apex:form>
            
            <script>
                var acc = document.getElementsByClassName("accordion");
    var i;
    
    for (i = 0; i < acc.length; i++) {
        acc[i].addEventListener("click", function() {
            this.classList.toggle("active");
            var panel = this.nextElementSibling;
            if (panel.style.maxHeight) {
                panel.style.maxHeight = null;
            } else {
                panel.style.maxHeight = panel.scrollHeight + "px";
            } 
        });
    }
    </script>
    
    <script>
    var app = angular.module('myApp', ['ngAnimate', 'ui.bootstrap']);
    app.controller('myCtrl', function($scope) {
        $scope.FeePlanListString = JSON.parse('{!JSENCODE(FeePlanListString)}');
        $scope.preparedFeePlanListString = '';
        $scope.PaymentlistString = JSON.parse('{!JSENCODE(PaymentlistString)}');
        var counter = 0;
        for(var i=0; i<$scope.FeePlanListString.length; i++){
            $scope.FeePlanListString[i].Child  = [];
            for(var j=0;j< $scope.PaymentlistString.length; j++){
                if($scope.FeePlanListString[i].Id == $scope.PaymentlistString[j].Program_Batch_Wise_Payment__c){
                    $scope.FeePlanListString[i].Child[counter++] = $scope.PaymentlistString[j];
                }
            }
            counter = 0;
        }
        console.log($scope.FeePlanListString);
        $scope.preparedFeePlanListString = $scope.FeePlanListString;
        
    });
    </script>
        </div>
    </body>
</html>
</apex:page>