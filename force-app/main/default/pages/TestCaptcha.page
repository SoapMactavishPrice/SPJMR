function validateForm() {

    let isValid = true;

    const mandatoryNames = ["first_name", "email", "phone"];
        var phoneInput = document.getElementById("phone");

if(phoneInput.value === "+91") {
    phoneInput.value = "";
}
    mandatoryNames.forEach(function(name) {
        const input = document.getElementsByName(name)[0];

        if(input && !input.value.trim()) {
            input.style.border = "2px solid red";
            isValid = false;
        } else if(input) {
            input.style.border = "";
        }
    });

    const allFieldDivs = document.querySelectorAll(".input-box");

    allFieldDivs.forEach(function(div) {

        if(div.offsetParent === null) return; 

        const input = div.querySelector("input, select");
        if(!input) return;

        if(mandatoryNames.includes(input.name)) return;

        if(!input.value.trim()) {
            input.style.border = "2px solid red";
            isValid = false;
        } else {
            input.style.border = "";
        }
    });

    if(!isValid) {
        alert("Please fill all required fields");
        return false;
    }
    combinePhone();

    submitFormToApex(
    document.getElementsByName("first_name")[0].value,
    document.getElementsByName("email")[0].value,
    document.getElementById("phone").value,
    programCode
);

    return true;
}

