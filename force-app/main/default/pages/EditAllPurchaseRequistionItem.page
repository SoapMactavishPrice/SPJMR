<apex:page controller="editAllPurchaseRequistionItem" sidebar="false" showHeader="false">
    
    <html>
        <apex:slds />
        <head>
               <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.12.0/jquery.min.js"></script>
                    <script type="text/javascript">
                        $(document).on("keypress", "input", function(e){
                        if(e.which == 13){
                            event.preventDefault();
                        }
                    });
                </script>
            </head>
        <style>
            table {
            border-collapse: collapse;
            border-spacing: 0;
            width: 100%;
            border: 1px solid #ddd;
            }
            
            th, td {
            text-align: left;
            padding: 8px;
            }
            
            tr:nth-child(even){background-color: #f2f2f2}
            
            .dateFormat{
            visibility:hidden;            
            }
        </style>
        
        <body class="slds-scope">
            <apex:form >
                <br/>
                
                <div class="slds-box" style="width: 95%;margin:auto">                      
                    <apex:pagemessages /> 
                    <p class="slds-text-title_caps" style="text-align:center;font-size:20px">Purchase Requuistion Line Item Information</p> 
                    
                    <br/> 
                    <div id="HtmlDiv" class="table-responsive">
                        <table class="slds-table slds-table_bordered slds-scrollable--x slds-table_col-bordered slds-table_resizable-cols"  style="width:100%">  
                            <tr> 
                                <th style="background-color:#b12327;color:white;white-space: auto;" class="slds-text-align_center ">Item Code</th>  
                                <th style="background-color:#b12327;color:white;white-space: auto;" class="slds-text-align_center ">Item Name</th>  
                                <th style="background-color:#b12327;color:white;white-space: auto;" class="slds-text-align_center ">Quantity</th>
                                <th style="background-color:#b12327;color:white;white-space: auto;" class="slds-text-align_center ">Sales UOM</th>
                                <th style="background-color:#b12327;color:white;white-space: auto;" class="slds-text-align_center ">Remark</th>
                              
                            </tr>                         
                            <apex:repeat value="{!bomitemList}" var="opp">
                                <tr>
                                    <td class="slds-text-align_left"><apex:outputField style="white-space:auto;" styleClass="slds-input" value="{!opp.Item_Code__c}"/></td>
                                    <td class="slds-text-align_left"><apex:outputField style="white-space:auto;" styleClass="slds-input" value="{!opp.Item_Name__c}"/></td>
                                    <td class="slds-text-align_center"><apex:inputField style="white-space:auto;" styleClass="slds-input" value="{!opp.Quantity__c }" /></td>
                                    <td Style="text-align:center;" ><apex:inputfield value="{!opp.Sales_UOM__c}"  style="width: 78%;margin-left:0px;line-height: 26px;"> </apex:inputfield></td>
                                    <td class="slds-text-align_center"><apex:inputField style="white-space:auto;" styleClass="slds-input" value="{!opp.Remark__c }" /></td>

                                  <!--  <td class="slds-text-align_center"><apex:outputField style="white-space:auto;" styleClass="slds-input" value="{!opp.ListPrice  }"/></td>
                                    <td class="slds-text-align_center"><apex:inputField style="white-space:auto;" styleClass="slds-input" value="{!opp.UnitPrice }"/></td>
                                    <td Style="text-align:center;" ><apex:inputfield value="{!opp.Tax_Code__c}"  style="width: 78%;margin-left:0px;line-height: 26px;"> </apex:inputfield></td>
                                    <td class="slds-text-align_center"><apex:inputField style="white-space:auto;" styleClass="slds-input" value="{!opp.Discount }" /></td>
                                    <td class="slds-text-align_center"><apex:outputField style="white-space:auto;" styleClass="slds-input" value="{!opp.Total_Amount_After_Tax__c }" /></td> -->
                                </tr>
                            </apex:repeat>   
                        </table>
                    </div>
                    
                    <div align="center" draggable="false">
                        <apex:commandButton value="Update" action="{!Save}"   styleClass="slds-button slds-button_neutral  slds-button__icon_right slds-button--brand slds-m-top--medium"/>
                        <apex:commandButton value="Cancel" action="{!Cancel}" styleClass="slds-button slds-button_destructive slds-button__icon_right slds-button--brand slds-m-top--medium"/>
                    </div>
                </div>
            </apex:form>  
        </body>
    </html>
</apex:page>